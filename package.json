{
  "name": "jira-command",
  "version": "0.1.0",
  "description": "CLI Jira em TypeScript ESM substituindo jira.ps1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "jira": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "picocolors": "^1.1.1",
    "undici": "^7.25.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
